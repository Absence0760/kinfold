# Committed local-dev defaults. Non-sensitive only — see CLAUDE.md,
# "Local-dev env is committed; real secrets never are."
#
# The Supabase publishable key is deliberately NOT here: `bin/dev-run-web.sh`
# reads it from `supabase status` at launch and exports PUBLIC_SUPABASE_ANON_KEY,
# so nothing key-shaped is written to disk.
#
# Machine-local overrides go in a gitignored .env.development.local (loaded last).

PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
